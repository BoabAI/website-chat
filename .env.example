# Copy to .env.local for local development.
#
# URL of the deployed Gemini proxy Function URL (Terraform output
# `proxy_function_url`). The API key now lives ONLY in that proxy — it is never
# exposed to the browser. Point this at the deployed proxy for local dev.
VITE_PROXY_URL=https://your-proxy-id.lambda-url.ap-southeast-2.on.aws/
